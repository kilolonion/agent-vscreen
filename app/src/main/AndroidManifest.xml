<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Local API server on 127.0.0.1 only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 1.3: scheduled wake-ups (vscreen wake). USE_EXACT_ALARM is granted at install on Android 13+; 12 / 12L use
         SCHEDULE_EXACT_ALARM, granted there by default. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <!-- 2.0.0-beta6 (6.1 L4): framework BiometricPrompt (BIOMETRIC_STRONG | DEVICE_CREDENTIAL) on StrongConfirmActivity. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="frb.axeron.manager" />
    </queries>

    <uses-sdk tools:overrideLibrary="rikka.shizuku.api,rikka.shizuku.provider,rikka.shizuku.shared,rikka.shizuku.aidl,top.yukonga.miuix.kmp.blur,top.yukonga.miuix.kmp.shader" />
    <!-- 1.4: miuix-blur declares minSdk 33 (RuntimeShader). It is only called behind Glass.blurOk (API 33+); below that the glass is a plain translucent fill. -->

    <application
        android:name=".host.VScreenApp"
        android:label="Agent-VScreen"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.FullscreenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.kilon.agentvscreen.fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.AgentVScreen.Fullscreen"
            android:windowSoftInputMode="adjustResize" />

        <!-- 1.3: the user answers an agent's question (tap on the picture, a box, a choice, a line). -->
        <activity
            android:name=".ui.AskActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.kilon.agentvscreen.ask"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- 1.3 示教: review what the user showed on the background screen and save it as a segment. -->
        <activity
            android:name=".ui.TeachActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 2.0.0-beta6 (6.1 L1): strong confirmation page — main display only, never exported, own task, excluded from recents. -->
        <activity
            android:name=".ui.StrongConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.kilon.agentvscreen.strongconfirm"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- 2.0.0-beta2: exported with DUMP because uid 2000 (Shizuku, or root's su 2000 mode) requires exported="true"
             to call `am start-foreground-service` (uid 0 bypasses exported checks). Ordinary third-party apps cannot
             hold DUMP, and HostService only accepts a plain start (notification actions live in non-exported NoteActions). -->
        <service
            android:name=".host.HostService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local automation server that keeps a virtual display for agent apps" />
        </service>

        <service
            android:name=".core.VScreenRules$RuleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches a condition on the virtual display for the user" />
        </service>

        <service
            android:name=".host.VScreenAccessibilityService"
            android:exported="true"
            android:label="Agent-VScreen"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/vscreen_accessibility_service" />
        </service>

        <!-- 2.0.0-beta2: notification action buttons (Stop / On / Allow / Show window / Hand back / Consent). -->
        <receiver android:name=".host.NoteActions" android:exported="false" />

        <receiver android:name=".host.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 1.3: the alarm of the wake-up schedule (and clock / time zone changes, which move it). -->
        <receiver android:name=".host.WakeAlarmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- 1.3: a local CLI that finds the app silent sends this explicit broadcast: it thaws the process and makes
             sure the service runs. No extras are read and nothing is returned. -->
        <receiver android:name=".host.WakeReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.kilon.agentvscreen.WAKE" />
            </intent-filter>
        </receiver>

        <!-- 1.4.2-beta3: the root-started screen service hands its binder over here (shell / root uids only, checked
             in the call). Exported because the shell reaches providers only through external access. -->
        <provider
            android:name=".host.RootLink"
            android:authorities="${applicationId}.root"
            android:exported="true"
            android:multiprocess="false" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
